# systemd service for Brewfather Reports (see docs/DEPLOY.md, "On a Plesk server").
# Copy to /etc/systemd/system/brew-reports.service, change the three marked lines, then:
#   systemctl daemon-reload && systemctl enable --now brew-reports

[Unit]
Description=Brewfather Reports
After=network-online.target
Wants=network-online.target

[Service]
# 1. the folder you installed it in
WorkingDirectory=/var/www/vhosts/yourdomain.com/brew-reports
# 2. Python 3.9+ (e.g. /usr/bin/python3.11 on AlmaLinux 8) and the port; use the same port in the nginx directives
ExecStart=/usr/bin/python3 -u app/server.py --proxy --port 8642
# 3. the subscription's system user (Plesk > Hosting & DNS > Hosting)
User=yoursysuser
Group=psacln
UMask=0027
Restart=on-failure
RestartSec=5
# keep it away from the rest of the system
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
